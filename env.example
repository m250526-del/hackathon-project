# New project's own Postgres connection string (Supabase: use the SESSION POOLER string, not the direct one)
DATABASE_URL=your-supabase-session-pooler-connection-string

# Shared secret for any protected API route
API_KEY=change-this-to-a-long-random-string

# Token that protects the /qr page used to pair WhatsApp
QR_TOKEN=change-this-to-another-long-random-string

# Port the server listens on
PORT=3000
