# Postgres connection string (Supabase: use the SESSION POOLER string, not the direct one)
DATABASE_URL=your-supabase-session-pooler-connection-string

# Shared secret for any protected API route
API_KEY=change-this-to-a-long-random-string

# Token that protects the /qr page used to pair WhatsApp
QR_TOKEN=change-this-to-another-long-random-string

# Port the server listens on
PORT=3000

# Google Gemini: three separate key pools, comma-separated, tried in order.
# When a key hits its quota or dies, the next one is used automatically.
# Create each key in its OWN Google Cloud project (free-tier quota is per project).
GEMINI_CHAT_KEYS=chat-key-1,chat-key-2,chat-key-3
GEMINI_STT_KEYS=stt-key-1,stt-key-2,stt-key-3
GEMINI_TTS_KEYS=tts-key-1,tts-key-2,tts-key-3
# Optional: one fallback key used for any pool whose list above is empty
GEMINI_API_KEY=
# Optional model overrides; defaults are gemini-3.5-flash-lite for chat/STT and gemini-3.8-flash-lite-tts for TTS.
# GEMINI_MODEL=gemini-3.5-flash-lite
# GEMINI_STT_MODEL=gemini-3.5-flash-lite
# GEMINI_TTS_MODEL=gemini-3.8-flash-lite-tts
GEMINI_TTS_VOICE=Kore
